{
  "name": "communityos-backend",
  "version": "1.0.0",
  "description": "CommunityOS Backend - Event-driven multi-community service platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development nodemon --watch src --exec node src/server.js",
    "start": "node src/server.js",
    "migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "seed": "node src/db/seed.js",
    "test": "echo \"Error: no test specified\" && exit 1"
    "lint": "eslint . --ext .js"
"format": "prettier --write ."
"ci": "npm run lint && npx prisma generate"
"test": "jest"
  },
  "keywords": [
    "community",
    "service",
    "platform",
    "event-driven"
  ],
  "author": "Charles Mosoti",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^4.18.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.3.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "postgres": "^3.3.5",
    "redis": "^4.6.12",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.1",
    "@supabase/supabase-js": "^2.35.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "^4.18.0"
  }
}
